---
import { getCollection } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';

const collections = await getCollection('docs', ({ id, data }) =>
  id.startsWith('collections/') && (import.meta.env.MODE !== 'production' || !data.draft)
);
collections.sort((a, b) =>
  (a.data.sidebar.order ?? Infinity) - (b.data.sidebar.order ?? Infinity) || a.id.localeCompare(b.id)
);

function collectionArt(id: string) {
  switch (id) {
    case 'collections/domain': return 'domain';
    case 'collections/statistics': return 'statistics';
    case 'collections/science': return 'science';
    default: return 'atlas';
  }
}
---

<section class="tabula-collections not-content" id="collections" aria-labelledby="tabula-collections-title">
  <div class="tabula-section-heading">
    <div>
      <h2 id="tabula-collections-title">Collections</h2>
      <p>Choose the research task you want to work on.</p>
    </div>
    <span class="tabula-count">{collections.length} {collections.length === 1 ? 'collection' : 'collections'}</span>
  </div>

  <ul class="tabula-card-grid" role="list">
    {collections.map(({ id, data }, index) => {
      const art = collectionArt(id);
      const labelId = `card-${id.replaceAll('/', '-')}`;
      const descriptionId = data.description ? `${labelId}-description` : undefined;
      return (
        <li>
          <a class="tabula-card" href={`/${id}/`} aria-labelledby={labelId} aria-describedby={descriptionId}>
            <div class="tabula-card__art" data-art={art}>
              <img src={`/assets/${art}.svg`} width={art === 'atlas' ? 40 : 320} height={art === 'atlas' ? 40 : 130} alt="" decoding="async" />
            </div>
            <div class="tabula-card__body">
              <span class="tabula-kicker" aria-hidden="true">Collection {String(index + 1).padStart(2, '0')}</span>
              <h3 id={labelId}>{data.title}</h3>
              {data.description && <p id={descriptionId}>{data.description}</p>}
              <span class="tabula-card__link" aria-hidden="true">
                Open collection <Icon name="right-arrow" class="rtl:flip" />
              </span>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
</section>

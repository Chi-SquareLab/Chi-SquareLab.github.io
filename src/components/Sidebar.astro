---
import { Badge, Icon } from '@astrojs/starlight/components';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { getProductGroups } from '../data/product-groups';
import { overviewPath } from '../navigation/legacy-bookmarks';

const { sidebar, id: currentId } = Astro.locals.starlightRoute;
const groups = await getProductGroups();
// For a direct visit, show the first matching group in directory order.
const defaultGroup = groups.find(({ products }) => products.some(({ id }) => id === currentId));

type SidebarEntry = (typeof sidebar)[number];
function hasCurrentLink(entries: SidebarEntry[]): boolean {
  return entries.some((entry) =>
    entry.type === 'link' ? entry.isCurrent : hasCurrentLink(entry.entries)
  );
}
---

<SidebarPersister>
  <ul class="sidebar-list" role="list">
    {sidebar.map((entry) => {
      if (entry.type === 'link') {
        const { class: linkClass, ...attrs } = entry.attrs;
        const isOverview = entry.href === overviewPath;
        return (
          <li class:list={{ 'overview-item': isOverview }}>
            <a
              href={entry.href}
              aria-current={entry.isCurrent ? 'page' : undefined}
              class:list={['sidebar-link', 'section-label', linkClass]}
              {...attrs}
            >
              {isOverview && <Icon name="open-book" size="16px" />}
              {entry.label}
              {entry.badge && <Badge text={entry.badge.text} variant={entry.badge.variant} class={entry.badge.class} />}
            </a>
          </li>
        );
      }

      const isCollections = entry.label === 'Collections';
      const open = !entry.collapsed || hasCurrentLink(entry.entries) || (isCollections && !!defaultGroup);
      return (
        <li>
          <details open={open} data-collections={isCollections ? '' : undefined}>
            <summary class="section-label" aria-current={isCollections && defaultGroup ? 'location' : undefined}>
              <span>
                {entry.label}
                {entry.badge && <Badge text={entry.badge.text} variant={entry.badge.variant} class={entry.badge.class} />}
              </span>
              <Icon name="right-caret" class="caret" size="1.25rem" />
            </summary>
            <SidebarRestorePoint />
            {isCollections ? (
              <ul class="sidebar-branch collection-groups" role="list">
                {groups.map(({ id, label, products }) => {
                  const labelId = `sidebar-group-${id}`;
                  return (
                    <li>
                      {products.length > 0 ? (
                        <details data-product-group={id} open={defaultGroup?.id === id}>
                          <summary class="collection-label" id={labelId} aria-current={defaultGroup?.id === id ? 'location' : undefined}>
                            {label}<Icon name="right-caret" class="caret" size="1rem" />
                          </summary>
                          <ul class="product-links" aria-labelledby={labelId} role="list">
                            {products.map((product) => (
                              <li>
                                <a
                                  class="sidebar-link"
                                  href={product.href}
                                  data-current-product={product.id === currentId ? '' : undefined}
                                  aria-current={product.id === currentId && defaultGroup?.id === id ? 'page' : undefined}
                                >{product.data.title}</a>
                              </li>
                            ))}
                          </ul>
                        </details>
                      ) : <p class="collection-label">{label}</p>}
                    </li>
                  );
                })}
              </ul>
            ) : (
              <div class="sidebar-branch">
                <SidebarSublist sublist={entry.entries} nested />
              </div>
            )}
          </details>
        </li>
      );
    })}
  </ul>
</SidebarPersister>

{defaultGroup && <script is:inline>
  // The static page is shared by all entry points. Resolve its branch after
  // Starlight restores the outer disclosure and before the sidebar is painted.
  const currentLinks = [...document.querySelectorAll('.sidebar-list [data-current-product]')];
  const groupOf = link => link.closest('[data-product-group]');
  const requested = new URLSearchParams(location.search).get('group');
  const selected = currentLinks.find(link => groupOf(link).dataset.productGroup === requested) || currentLinks[0];
  for (const link of currentLinks) {
    const active = link === selected;
    const group = groupOf(link);
    group.open = active;
    const label = group.querySelector('summary');
    if (active) {
      group.parentElement.closest('details').open = true;
      label.setAttribute('aria-current', 'location');
      link.setAttribute('aria-current', 'page');
    } else {
      label.removeAttribute('aria-current');
      link.removeAttribute('aria-current');
    }
  }
</script>}

<div class="md:sl-hidden"><MobileMenuFooter /></div>

<style>
  .sidebar-list,
  .collection-groups,
  .product-links {
    padding: 0;
    list-style: none;
  }

  .sidebar-list {
    --item-padding: 0.5rem;
    --section-size: var(--sl-text-lg);
    --link-size: var(--sl-text-base);
    overflow-wrap: anywhere;
  }

  .sidebar-list > li + li {
    margin-block-start: 0.75rem;
  }

  .sidebar-list .overview-item + li {
    margin-block-start: 1.125rem;
  }

  .overview-item > .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.45rem;
    border-radius: 0.5rem;
  }

  .section-label,
  .sidebar-link {
    padding-inline: var(--item-padding);
    border-radius: 0.25rem;
    line-height: 1.4;
  }

  .sidebar-link {
    display: block;
    padding-block: 0.3em;
    color: var(--sl-color-gray-2);
    font-size: var(--link-size);
    text-decoration: none;
  }

  .section-label {
    color: var(--sl-color-white);
    font-size: var(--section-size);
    font-weight: 600;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--item-padding);
    padding-block: 0.2em;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .caret {
    flex: none;
  }

  :global([dir='rtl']) .caret {
    transform: rotate(180deg);
  }

  details[open] > summary .caret {
    transform: rotate(90deg);
  }

  .sidebar-branch {
    margin-inline-start: var(--item-padding);
    padding-inline-start: var(--item-padding);
    border-inline-start: 1px solid var(--sl-color-hairline-light);
  }

  .collection-groups > li + li {
    margin-block-start: 0.375rem;
  }

  .collection-label {
    padding: 0.25rem var(--item-padding) 0.125rem;
    color: var(--tabula-muted);
    font-size: var(--link-size);
    font-weight: 600;
    line-height: 1.4;
  }

  .product-links .sidebar-link {
    padding-inline-start: calc(2 * var(--item-padding));
  }

  .sidebar-link:hover {
    text-decoration: underline;
  }

  summary[aria-current='location'] {
    color: var(--sl-color-text-accent);
    font-weight: 700;
  }

  .sidebar-link[aria-current='page'] {
    color: var(--tabula-sidebar-active-ink);
    background-color: var(--tabula-sidebar-active-bg);
    box-shadow: inset 2.5px 0 0 var(--tabula-fill-accent);
    font-weight: 640;
  }

  summary:focus-visible,
  .sidebar-link:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  @media (min-width: 50rem) {
    .sidebar-list {
      --section-size: var(--sl-text-base);
      --link-size: var(--sl-text-sm);
    }

    .sidebar-list > li + li {
      margin-block-start: 0.5rem;
    }
  }
</style>

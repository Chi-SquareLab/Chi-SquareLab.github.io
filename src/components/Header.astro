---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
const path = Astro.url.pathname;
const section = /^\/(products|collections)\//.test(path) ? 'Collections'
  : /^\/(examples|reference)\//.test(path) ? 'Reference' : 'Getting Started';
const links = [['Getting Started', '/quickstart/'], ['Collections', '/#collections'], ['Reference', '/reference/model-architecture/']];
---
<div class="topbar flex items-center">
  <a class="brand" href="/"><img src="/assets/atlas.svg" alt="" width="32" height="32"/>Tabula</a>
  <nav aria-label="Main navigation" data-root-nav={path === '/' ? '' : undefined}>{links.map(([label, href]) => <a href={href} aria-current={label === section ? 'location' : undefined}>{label}</a>)}</nav>
  <div class="tools"><Search /><span class="appearance"><ThemeSelect /></span></div>
</div>
<script>
  // Existing bookmarks used hash routes. Only translate them on the homepage.
  function routeBookmark() {
    if (location.pathname !== '/') return;
    const [route, part] = location.hash.slice(1).split('/');
    const routes: Record<string,string> = {
      overview: '/', quickstart: '/quickstart/', domain: '/collections/domain/',
      statistics: '/collections/statistics/', science: '/collections/science/',
      architecture: '/reference/model-architecture/', references: '/reference/reading-list/',
    };
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('nav[data-root-nav] a');
    for (const link of navLinks) {
      if (link.hash === '#collections' ? route === 'collections' : link.pathname === '/quickstart/' && route !== 'collections') link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    if (!Object.hasOwn(routes, route)) return;
    const target = part && ['domain', 'statistics', 'science'].includes(route)
      ? '/examples/' + route + '/' : routes[route];
    location.replace(target + (part ? '#' + encodeURIComponent(part) : ''));
  }
  routeBookmark();
  window.addEventListener('hashchange', routeBookmark);
</script>
<style>
  .topbar {height:100%; gap:clamp(.75rem,3vw,2.4rem)}
  .brand {display:inline-flex;align-items:center;gap:.65rem;text-decoration:none;color:var(--sl-color-white);font-size:1.35rem;font-weight:720;letter-spacing:-.04em}
  nav,.tools {display:flex;align-items:center;gap:1.3rem}
  nav {height:100%} nav a {display:inline-flex;align-items:center;height:100%;text-decoration:none;font-size:.9rem;color:var(--sl-color-text);border-bottom:2px solid transparent}
  nav a[aria-current],nav a:hover {color:var(--sl-color-text-accent);border-color:currentColor}
  .tools {margin-inline-start:auto;gap:.6rem}
  @media(max-width:49.99rem){nav,.appearance {display:none}}
</style>

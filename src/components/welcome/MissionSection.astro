---
import { mission } from '../../data/welcome-content';
---

<section id="mission" class="mission-section" aria-labelledby="mission-title" data-reveal-group>
  <header class="section-rule" data-reveal>
    <span class="folio">02 / Statement</span>
    <h2 id="mission-title">{mission.sectionTitle}</h2>
  </header>

  <div class="mission-canvas" data-reveal>
    <svg
      class="mission-backdrop"
      viewBox="0 0 1200 500"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id="chi-crimson" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#a02337" stop-opacity="0" />
          <stop offset="24%" stop-color="#a02337" stop-opacity="0.22" />
          <stop offset="76%" stop-color="#b8624d" stop-opacity="0.2" />
          <stop offset="100%" stop-color="#b8624d" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="chi-cyan" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#316b78" stop-opacity="0" />
          <stop offset="32%" stop-color="#316b78" stop-opacity="0.24" />
          <stop offset="82%" stop-color="#56796b" stop-opacity="0.16" />
          <stop offset="100%" stop-color="#56796b" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="chi-gold" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#c3a16a" stop-opacity="0" />
          <stop offset="40%" stop-color="#c3a16a" stop-opacity="0.34" />
          <stop offset="86%" stop-color="#c3a16a" stop-opacity="0.14" />
          <stop offset="100%" stop-color="#c3a16a" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- Subtle baseline & ticks on archival paper -->
      <g class="mission-axes">
        <path d="M40 426H1160" />
        <path d="M220 420V432M420 420V432M620 420V432M820 420V432M1020 420V432" />
      </g>

      <!-- Scroll-drawn chi-square density family curves integrated softly into the paper canvas -->
      <path
        class="chi-curve"
        data-chi-curve
        stroke="url(#chi-crimson)"
        stroke-width="1.5"
        d="M52 426 C112 422, 146 142, 224 128 C312 112, 392 312, 536 384 C692 420, 896 424, 1148 426"
      />
      <path
        class="chi-curve"
        data-chi-curve
        stroke="url(#chi-cyan)"
        stroke-width="1.5"
        d="M52 426 C152 426, 222 198, 344 186 C466 174, 566 346, 738 402 C886 424, 1028 425, 1148 426"
      />
      <path
        class="chi-curve"
        data-chi-curve
        stroke="url(#chi-gold)"
        stroke-width="1.25"
        stroke-dasharray="5 7"
        d="M52 426 C224 426, 330 264, 494 246 C650 228, 768 374, 952 414 C1034 424, 1094 425, 1148 426"
      />

      <!-- Subtle traveling light pulses echoing the hero's auto-playing rhythm -->
      <path
        class="chi-pulse"
        pathLength="1"
        stroke="#a02337"
        d="M52 426 C112 422, 146 142, 224 128 C312 112, 392 312, 536 384 C692 420, 896 424, 1148 426"
      />
      <path
        class="chi-pulse is-cyan"
        pathLength="1"
        stroke="#316b78"
        d="M52 426 C152 426, 222 198, 344 186 C466 174, 566 346, 738 402 C886 424, 1028 425, 1148 426"
      />
    </svg>

    <div class="mission-top">
      <p class="pullquote">
        {mission.statement.lead}{' '}
        <em>{mission.statement.emphasis}</em>
      </p>

      <div class="mission-copy">
        {mission.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <ol class="mission-pillars" aria-label="Core research pillars">
      {mission.pillars.map((pillar, i) => (
        <li class="pillar-item" data-reveal>
          <div class="pillar-head">
            <span class="pillar-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="pillar-kicker">{pillar.kicker}</span>
          </div>
          <h3>{pillar.title}</h3>
          <p>{pillar.summary}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .mission-section {
    margin-block: clamp(3.75rem, 7vw, 6.5rem) clamp(3rem, 5.5vw, 4.75rem);
  }

  .mission-canvas {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(2rem, 4.2vw, 3.6rem) clamp(1.5rem, 3.8vw, 3.25rem);
    border-radius: 1rem;
    border: 1px solid var(--rule);
    background: linear-gradient(180deg, rgb(252 251 249 / 0.9) 0%, rgb(var(--brand-ivory-rgb) / 0.78) 100%);
  }

  .mission-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .mission-axes path {
    fill: none;
    stroke: rgb(var(--brand-graphite-rgb) / 0.08);
    stroke-width: 1;
  }

  .chi-curve {
    fill: none;
    stroke-linecap: round;
  }

  .chi-pulse {
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-dasharray: 0.08 0.92;
    stroke-dashoffset: 1;
    opacity: 0.3;
    animation: chi-trace 11s linear infinite;
  }

  .chi-pulse.is-cyan {
    animation-duration: 13.5s;
    animation-delay: -4.5s;
    opacity: 0.28;
  }

  @keyframes chi-trace {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: -0.15; }
  }

  .mission-top {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.75rem, 4.5vw, 4.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .pullquote {
    margin: 0;
    font: 400 clamp(2.15rem, 3.6vw, 3.45rem) / 1.09 var(--serif);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .pullquote em {
    color: var(--crimson);
    font-style: italic;
  }

  .mission-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 0.99rem;
    line-height: 1.72;
  }

  .mission-copy p + p {
    margin-top: 1.05rem;
  }

  .mission-pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: clamp(1.75rem, 3.2vw, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .pillar-item {
    position: relative;
    padding-top: 1.15rem;
    border-top: 1px solid var(--rule);
  }

  .pillar-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.7rem;
    font: 600 0.67rem / 1.3 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .pillar-index {
    color: var(--crimson);
  }

  .pillar-kicker {
    color: var(--cyan);
  }

  .pillar-item h3 {
    margin: 0 0 0.5rem;
    color: var(--ink);
    font: 500 1.24rem / 1.24 var(--serif);
    letter-spacing: -0.015em;
  }

  .pillar-item p {
    margin: 0;
    color: var(--muted);
    font-size: 0.91rem;
    line-height: 1.64;
  }

  @media (max-width: 56rem) {
    .mission-top,
    .mission-pillars {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chi-pulse {
      animation: none;
      opacity: 0;
    }
  }
</style>

---
// Pure conceptual auto-playing TFM forward schematic (no numeric values, no live computation).
// Single unified pass: Context & Query → TFM forward → Predictive curve, point estimate ŷ, and interval band.

const ambientPaths = [
  { d: 'M18 198 C206 118, 404 148, 608 242', pulseClass: '' },
  { d: 'M36 330 C230 302, 424 276, 608 296', pulseClass: 'p-mid' },
  { d: 'M18 468 C222 478, 412 390, 608 352', pulseClass: 'p-low' },
];

const attentionPaths = [
  { d: 'M842 252 C874 252, 886 270, 912 280', pulseClass: 'flow-tech p1' },
  { d: 'M842 286 C874 286, 886 296, 906 300', pulseClass: 'flow-tech p2' },
  { d: 'M842 320 C874 320, 886 318, 906 320', pulseClass: 'flow-tech p3' },
  { d: 'M842 358 C876 358, 888 342, 912 334', pulseClass: 'flow-crimson p4' },
];

const projectionPath = 'M1066 310 L1254 310';
const densityPath =
  'M1130 310 C1164 310, 1186 296, 1208 266 C1226 242, 1238 232, 1251 232 C1264 232, 1276 242, 1294 266 C1316 296, 1338 310, 1372 310';
---

<svg data-stage-svg viewBox="0 0 1440 620" preserveAspectRatio="xMidYMid meet" focusable="false">
  <defs>
    <radialGradient id="fg-scrim" cx="22%" cy="50%" r="36%">
      <stop offset="0%" stop-color="#f9f7f4" stop-opacity="0.94" />
      <stop offset="70%" stop-color="#f9f7f4" stop-opacity="0.54" />
      <stop offset="100%" stop-color="#f9f7f4" stop-opacity="0" />
    </radialGradient>

    <radialGradient id="tfm-aura" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#316b78" stop-opacity="0.16" />
      <stop offset="65%" stop-color="#b8624d" stop-opacity="0.06" />
      <stop offset="100%" stop-color="#316b78" stop-opacity="0" />
    </radialGradient>

    <radialGradient id="point-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#a02337" stop-opacity="0.34" />
      <stop offset="100%" stop-color="#a02337" stop-opacity="0" />
    </radialGradient>

    <linearGradient id="stream-tech" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#316b78" stop-opacity="0.16" />
      <stop offset="55%" stop-color="#316b78" stop-opacity="0.78" />
      <stop offset="100%" stop-color="#24262b" stop-opacity="0.92" />
    </linearGradient>

    <linearGradient id="stream-crimson" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#a02337" stop-opacity="0.24" />
      <stop offset="55%" stop-color="#a02337" stop-opacity="0.95" />
      <stop offset="100%" stop-color="#b8624d" stop-opacity="0.95" />
    </linearGradient>

    <linearGradient id="ambient-gold" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#c3a16a" stop-opacity="0" />
      <stop offset="45%" stop-color="#c3a16a" stop-opacity="0.48" />
      <stop offset="85%" stop-color="#b8624d" stop-opacity="0.4" />
      <stop offset="100%" stop-color="#b8624d" stop-opacity="0" />
    </linearGradient>

    <linearGradient id="conformal-fill" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#316b78" stop-opacity="0.06" />
      <stop offset="50%" stop-color="#316b78" stop-opacity="0.24" />
      <stop offset="100%" stop-color="#316b78" stop-opacity="0.06" />
    </linearGradient>

    <linearGradient id="density-fill" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#24262b" stop-opacity="0.13" />
      <stop offset="100%" stop-color="#24262b" stop-opacity="0" />
    </linearGradient>

    <filter id="soft-bloom" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="3.5" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Delicate silk threads weaving behind the left headline into the right forward pass -->
  <g class="ambient-field" data-parallax="-5">
    {ambientPaths.map(({ d }) => <path class="ambient-curve" d={d} />)}
    {ambientPaths.map(({ d, pulseClass }) => (
      <path class:list={['ambient-pulse', pulseClass]} pathLength="1" d={d} />
    ))}
    <circle class="ambient-node" cx="256" cy="146" r="2.8" />
    <circle class="ambient-node" cx="468" cy="284" r="2.8" />
    <circle class="ambient-node" cx="378" cy="436" r="3" />
  </g>

  <!-- Soft radial ivory scrim keeping foreground typography effortless to read -->
  <rect class="headline-scrim" x="0" y="40" width="590" height="540" fill="url(#fg-scrim)" />

  <!-- Unified single-track connecting streams: Table → TFM → Prediction & Interval -->
  <g class="layer-streams" data-parallax="7">
    <g class="stream-base">
      {attentionPaths.map(({ d }) => <path d={d} />)}
    </g>

    <g class="stream-active">
      {attentionPaths.map(({ d, pulseClass }) => (
        <path class:list={['flow-pulse', pulseClass]} pathLength="1" d={d} />
      ))}
    </g>

    <!-- Single forward ray emerging from the TFM into the output distribution -->
    <path class="projection-base" d={projectionPath} />
    <path class="projection-pulse" pathLength="1" d={projectionPath} />
  </g>

  <!-- 1. Tabular Input (Context rows + Query ?) -->
  <g class="layer-inputs" data-parallax="10">
    <rect class="panel-glass" x="608" y="224" width="234" height="164" rx="12" />
    <path class="table-grid" d="M686 224V388M740 224V388M794 224V388" />
    <path class="table-grid" d="M608 264H842M608 300H842M608 336H842" />

    <g class="ctx-rows">
      <text class="row-tag" x="622" y="249">Context</text>
      <rect class="cell-bar" x="696" y="242" width="32" height="5.5" rx="2.75" />
      <rect class="cell-bar" x="750" y="242" width="26" height="5.5" rx="2.75" />
      <circle class="target-dot" cx="818" cy="245" r="4.2" />

      <text class="row-tag" x="622" y="286">Context</text>
      <rect class="cell-bar" x="696" y="279" width="22" height="5.5" rx="2.75" />
      <rect class="cell-bar" x="750" y="279" width="34" height="5.5" rx="2.75" />
      <circle class="target-dot" cx="818" cy="282" r="4.2" />

      <text class="row-tag" x="622" y="322">Context</text>
      <rect class="cell-bar" x="696" y="315" width="36" height="5.5" rx="2.75" />
      <rect class="cell-bar" x="750" y="315" width="20" height="5.5" rx="2.75" />
      <circle class="target-dot" cx="818" cy="318" r="4.2" />
    </g>

    <g class="query-row">
      <path class="query-fill" d="M609 337H841V376A11 11 0 0 1 830 387H620A11 11 0 0 1 609 376Z" />
      <rect class="query-sweep" x="609" y="337" width="232" height="50" rx="11" />
      <text class="row-tag is-query" x="622" y="366">Query</text>
      <rect class="cell-bar is-query" x="696" y="359" width="28" height="5.5" rx="2.75" />
      <rect class="cell-bar is-query" x="750" y="359" width="30" height="5.5" rx="2.75" />
      <circle class="query-socket" cx="818" cy="362" r="10" />
      <text class="query-q" x="818" y="366.5" text-anchor="middle">?</text>
    </g>
  </g>

  <!-- 2. TFM Forward Manifold -->
  <g class="layer-forward" data-parallax="14">
    <circle class="tfm-glow" cx="984" cy="310" r="112" fill="url(#tfm-aura)" />
    <circle class="tfm-orbit" cx="984" cy="310" r="88" />
    <circle class="tfm-orbit-inner" cx="984" cy="310" r="66" />

    <g class="tfm-prism">
      <polygon class="prism-back" points="984,226 1064,310 984,394 904,310" />
      <polygon class="prism-mid" points="984,244 1048,310 984,376 920,310" />
      <polygon class="prism-core" points="984,262 1030,310 984,358 938,310" />

      <path
        class="prism-lattice"
        d="M920 310L1048 310M984 244L984 376M952 277L1016 343M1016 277L952 343"
      />

      <g class="prism-nodes">
        <circle cx="920" cy="310" r="3.6" />
        <circle cx="1048" cy="310" r="3.6" />
        <circle cx="984" cy="244" r="3.6" />
        <circle cx="984" cy="376" r="3.6" />
        <circle cx="952" cy="277" r="3" />
        <circle cx="1016" cy="277" r="3" />
        <circle cx="952" cy="343" r="3" />
        <circle cx="1016" cy="343" r="3" />
        <circle class="prism-center-node" cx="984" cy="310" r="6.2" />
      </g>
    </g>
  </g>

  <!-- 3. Predictive Distribution, Point Estimate ŷ & Conformal Interval ŷ ± q̂ -->
  <g class="layer-output" data-parallax="12">
    <rect class="response-field" x="1108" y="218" width="286" height="184" rx="14" />

    <path class="density-area" fill="url(#density-fill)" d={`${densityPath} Z`} />
    <path class="density-stroke" d={densityPath} />

    <line class="response-axis" x1="1126" y1="310" x2="1376" y2="310" />
    <g class="axis-ticks">
      <line x1="1151" y1="305" x2="1151" y2="315" />
      <line x1="1201" y1="305" x2="1201" y2="315" />
      <line x1="1251" y1="303" x2="1251" y2="317" />
      <line x1="1301" y1="305" x2="1301" y2="315" />
      <line x1="1351" y1="305" x2="1351" y2="315" />
    </g>

    <!-- Conformal prediction band unfurling symmetrically around ŷ -->
    <g class="conformal-band-group">
      <rect class="conformal-shade" x="1177" y="290" width="148" height="40" rx="5" fill="url(#conformal-fill)" />
      <line class="conformal-bar" x1="1177" y1="310" x2="1325" y2="310" />
      <path class="conformal-caps" d="M1177 292V328M1325 292V328" />
      <text class="symbol-teal" x="1177" y="352" text-anchor="middle">ŷ − q̂</text>
      <text class="symbol-teal" x="1325" y="352" text-anchor="middle">ŷ + q̂</text>
    </g>

    <!-- Point estimate ŷ -->
    <g class="point-estimate-group">
      <circle class="point-aura" cx="1251" cy="310" r="24" fill="url(#point-glow)" />
      <circle class="point-ripple r1" cx="1251" cy="310" r="13" />
      <circle class="point-ripple r2" cx="1251" cy="310" r="21" />
      <line class="point-drop" x1="1251" y1="234" x2="1251" y2="310" />
      <circle class="point-core" cx="1251" cy="310" r="6" filter="url(#soft-bloom)" />
      <text class="symbol-rust" x="1251" y="352" text-anchor="middle">ŷ</text>
    </g>
  </g>
</svg>

<script>
  const svg = document.querySelector<SVGSVGElement>('[data-stage-svg]');
  if (svg) {
    const narrowMq = window.matchMedia('(max-width: 62rem)');
    const syncViewBox = () => {
      svg.setAttribute('viewBox', narrowMq.matches ? '592 198 818 228' : '0 0 1440 620');
    };
    syncViewBox();
    narrowMq.addEventListener('change', syncViewBox);
  }
</script>

<style>
  svg {
    --cycle: 9.6s;
    width: min(100%, 94rem);
    height: 100%;
    display: block;
    overflow: visible;
  }

  /* ---- Ambient Left-to-Right Weave ---- */
  .ambient-curve {
    fill: none;
    stroke: rgb(var(--brand-gold-rgb) / 0.32);
    stroke-width: 1.25;
    stroke-dasharray: 4 6;
  }

  .ambient-pulse {
    fill: none;
    stroke: url(#ambient-gold);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 0.14 0.86;
    stroke-dashoffset: 1;
    opacity: 0.72;
    animation: stream-loop 5.8s linear infinite;
  }

  .ambient-pulse.p-mid {
    animation-delay: -1.9s;
    animation-duration: 6.5s;
  }

  .ambient-pulse.p-low {
    animation-delay: -3.6s;
    animation-duration: 6.1s;
  }

  .ambient-node {
    fill: var(--gold);
    opacity: 0.5;
  }

  /* ---- Input Table ---- */
  .panel-glass {
    fill: rgb(252 251 249 / 0.9);
    stroke: var(--rule);
    stroke-width: 1.25;
    animation: table-focus var(--cycle) ease-in-out infinite;
  }

  .table-grid {
    fill: none;
    stroke: rgb(var(--brand-graphite-rgb) / 0.1);
    stroke-width: 1;
  }

  .row-tag {
    fill: var(--muted);
    font: 600 11px / 1 var(--mono);
    letter-spacing: 0.02em;
  }

  .row-tag.is-query {
    fill: var(--crimson);
    font-weight: 700;
  }

  .cell-bar {
    fill: var(--cyan);
    opacity: 0.56;
  }

  .cell-bar.is-query {
    fill: var(--crimson);
    opacity: 0.82;
  }

  .target-dot {
    fill: var(--sage);
    opacity: 0.9;
  }

  .query-fill {
    fill: rgb(var(--brand-crimson-rgb) / 0.08);
  }

  .query-sweep {
    fill: none;
    stroke: var(--crimson);
    stroke-width: 1.6;
    animation: query-cycle var(--cycle) ease-in-out infinite;
  }

  .query-socket {
    fill: var(--paper-light);
    stroke: var(--crimson);
    stroke-width: 1.5;
    stroke-dasharray: 3 2.5;
  }

  .query-q {
    fill: var(--crimson);
    font: 700 12.5px / 1 var(--mono);
  }

  /* ---- Attention Streams ---- */
  .stream-base path {
    fill: none;
    stroke: rgb(var(--brand-graphite-rgb) / 0.16);
    stroke-width: 1.35;
  }

  .flow-pulse {
    fill: none;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-dasharray: 0.24 0.76;
    stroke-dashoffset: 1;
    animation: attention-cycle var(--cycle) cubic-bezier(0.35, 0, 0.25, 1) infinite;
  }

  .flow-tech {
    stroke: url(#stream-tech);
  }

  .flow-crimson {
    stroke: url(#stream-crimson);
    stroke-width: 3;
  }

  .flow-pulse.p2 { animation-delay: 0.14s; }
  .flow-pulse.p3 { animation-delay: 0.28s; }
  .flow-pulse.p4 { animation-delay: 0.08s; }

  .projection-base {
    fill: none;
    stroke: rgb(var(--brand-graphite-rgb) / 0.16);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
  }

  .projection-pulse {
    fill: none;
    stroke: url(#stream-crimson);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: ray-cycle var(--cycle) cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  /* ---- TFM Manifold Prism ---- */
  .tfm-orbit,
  .tfm-orbit-inner {
    fill: none;
    stroke: rgb(var(--brand-cyan-rgb) / 0.22);
    stroke-width: 1;
    stroke-dasharray: 3 6;
    transform-origin: 984px 310px;
    animation: orbit-spin 26s linear infinite;
  }

  .tfm-orbit-inner {
    stroke: rgb(var(--brand-gold-rgb) / 0.56);
    stroke-dasharray: 16 9;
    animation: orbit-spin 18s linear infinite reverse;
  }

  .prism-back {
    fill: rgb(var(--brand-cyan-rgb) / 0.06);
    stroke: rgb(var(--brand-cyan-rgb) / 0.28);
    stroke-width: 1.25;
  }

  .prism-mid {
    fill: rgb(var(--brand-graphite-rgb) / 0.08);
    stroke: var(--ink);
    stroke-width: 1.35;
  }

  .prism-core {
    fill: var(--ink);
    stroke: var(--gold);
    stroke-width: 1.45;
    transform-origin: 984px 310px;
    animation: prism-pulse var(--cycle) ease-in-out infinite;
  }

  .prism-lattice {
    fill: none;
    stroke: rgb(var(--brand-ivory-rgb) / 0.3);
    stroke-width: 1;
  }

  .prism-nodes circle {
    fill: var(--paper-light);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  .prism-center-node {
    fill: var(--gold);
    stroke: var(--paper-light);
    stroke-width: 2;
  }

  /* ---- Predictive Output & Conformal Interval ---- */
  .response-field {
    fill: rgb(252 251 249 / 0.84);
    stroke: var(--rule);
    stroke-width: 1.2;
  }

  .density-stroke {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.65;
    animation: density-cycle var(--cycle) ease-in-out infinite;
  }

  .density-area {
    animation: density-cycle var(--cycle) ease-in-out infinite;
  }

  .response-axis {
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .axis-ticks line {
    stroke: rgb(var(--brand-graphite-rgb) / 0.35);
    stroke-width: 1.2;
  }

  .point-estimate-group {
    animation: point-cycle var(--cycle) ease-out infinite;
  }

  .point-drop {
    stroke: var(--crimson);
    stroke-width: 1.25;
    stroke-dasharray: 3 3;
    opacity: 0.72;
  }

  .point-core {
    fill: var(--crimson);
    stroke: var(--paper-light);
    stroke-width: 2;
  }

  .point-ripple {
    fill: none;
    stroke: var(--crimson);
    stroke-width: 1.5;
    transform-origin: 1251px 310px;
    animation: ripple-cycle var(--cycle) ease-out infinite;
  }

  .point-ripple.r2 {
    animation-delay: 0.28s;
  }

  .symbol-rust {
    fill: var(--crimson);
    font: 700 17px / 1 var(--serif);
    font-style: italic;
  }

  .conformal-band-group {
    transform-origin: 1251px 310px;
    animation: band-cycle var(--cycle) cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .conformal-bar {
    stroke: var(--cyan);
    stroke-width: 3.4;
    stroke-linecap: round;
  }

  .conformal-caps {
    fill: none;
    stroke: var(--cyan);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .symbol-teal {
    fill: var(--cyan);
    font: 700 13.5px / 1 var(--mono);
  }

  /* ---- Choreographed 9.6s Seamless Loop ----
     0–20%:  Input table & Query ? highlight
     18–45%: Attention pulses stream into TFM prism
     42–62%: Forward ray locks point estimate ŷ
     58–88%: Conformal band ŷ ± q̂ unfurls symmetrically & holds
     88–100%: Soft reset into next cycle */
  @keyframes stream-loop {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: -0.25; }
  }

  @keyframes orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes table-focus {
    0%, 24% { stroke: var(--crimson); }
    34%, 92% { stroke: var(--rule); }
    100% { stroke: var(--crimson); }
  }

  @keyframes query-cycle {
    0%, 22% { opacity: 0.95; }
    35%, 90% { opacity: 0.22; }
    100% { opacity: 0.95; }
  }

  @keyframes attention-cycle {
    0%, 16% { opacity: 0; stroke-dashoffset: 1; }
    22% { opacity: 1; stroke-dashoffset: 1; }
    44% { opacity: 1; stroke-dashoffset: -0.25; }
    48%, 100% { opacity: 0; stroke-dashoffset: -0.25; }
  }

  @keyframes prism-pulse {
    0%, 24% { transform: scale(1); }
    34%, 46% { transform: scale(1.07); }
    56%, 100% { transform: scale(1); }
  }

  @keyframes ray-cycle {
    0%, 38% { opacity: 0; stroke-dashoffset: 1; }
    42% { opacity: 1; stroke-dashoffset: 1; }
    54% { opacity: 1; stroke-dashoffset: 0; }
    86% { opacity: 0.55; stroke-dashoffset: 0; }
    94%, 100% { opacity: 0; stroke-dashoffset: 0; }
  }

  @keyframes density-cycle {
    0%, 40% { opacity: 0.4; }
    52%, 88% { opacity: 1; }
    96%, 100% { opacity: 0.4; }
  }

  @keyframes point-cycle {
    0%, 44% { opacity: 0.35; }
    52%, 88% { opacity: 1; }
    96%, 100% { opacity: 0.35; }
  }

  @keyframes ripple-cycle {
    0%, 47% { transform: scale(0.5); opacity: 0; }
    50% { transform: scale(0.6); opacity: 0.85; }
    64% { transform: scale(1.75); opacity: 0; }
    100% { transform: scale(1.75); opacity: 0; }
  }

  @keyframes band-cycle {
    0%, 58% { transform: scaleX(0.14); opacity: 0; }
    68%, 88% { transform: scaleX(1); opacity: 1; }
    96%, 100% { transform: scaleX(0.14); opacity: 0; }
  }

  @media (max-width: 62rem) {
    svg {
      width: 100%;
      height: auto;
      aspect-ratio: 818 / 228;
      border-radius: 0.9rem;
      border: 1px solid var(--rule);
      background: rgb(252 251 249 / 0.85);
    }

    .headline-scrim {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg,
    svg * {
      animation: none !important;
      transition: none !important;
    }
    .point-estimate-group,
    .conformal-band-group,
    .density-stroke,
    .density-area {
      opacity: 1 !important;
      transform: none !important;
    }
    .point-ripple,
    .flow-pulse,
    .projection-pulse,
    .ambient-pulse {
      opacity: 0 !important;
    }
  }
</style>

---
import { researchNews } from '../../data/welcome-content';
import NewsCover from './NewsCover.astro';

const [latest, ...archive] = researchNews;

const placeholderArchive = [
  {
    slot: 'Slot 02 · Placeholder',
    kind: 'Preprint / Method',
    title: 'Upcoming tabular inference paper',
    summary: 'Reserved for an earlier dated paper or benchmark release once entries are added to the bulletin feed.',
  },
  {
    slot: 'Slot 03 · Placeholder',
    kind: 'Release / Open Tool',
    title: 'Upcoming open-source release or tutorial update',
    summary: 'Chronological updates appear here automatically as newer dispatches take the featured spotlight above.',
  },
];

// A single published story has no archive. Sample rows belong only to the empty feed.
const earlierStories = latest ? archive : placeholderArchive;

const formatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const displayDate = (date: string) => formatter.format(new Date(date));
---

<section id="news" class="news-section" aria-labelledby="news-title" data-reveal-group>
  <header class="section-rule" data-reveal>
    <span class="folio">01 / Bulletin</span>
    <h2 id="news-title">Our research news</h2>
  </header>

  <article class="lead-story" data-spotlight data-reveal>
    <div class="lead-main">
      <div class="lead-meta">
        <span class:list={['status-pill', { 'is-live': latest }]}>
          <span class="status-dot" aria-hidden="true"></span>
          {latest ? 'Latest update' : 'Latest · Placeholder'}
        </span>
        {latest && <time class="datestamp" datetime={latest.date}>{displayDate(latest.date)}</time>}
        {latest && <span class="kind-pill">{latest.kind}</span>}
      </div>

      <h3 class="lead-headline">
        {latest ? (
          <a href={latest.url}>
            {latest.title}
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          'Featured research highlight reserved for our latest release'
        )}
      </h3>

      <p class="lead-summary">
        {latest?.summary ??
          'Our most recent paper, benchmark, or release is promoted here automatically. Add a dated record to src/data/research-news.json to publish the lead dispatch and replace these placeholder slots.'}
      </p>

      {latest && (
        <a class="lead-cta" href={latest.url}>
          Read full dispatch <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>

    <NewsCover story={latest} />
  </article>

  {earlierStories.length > 0 && (
    <ol
      class:list={['news-archive', { 'is-placeholder': !latest }]}
      aria-label={latest ? 'Earlier research news' : 'Placeholder earlier research slots'}
    >
      {earlierStories.map((item) => (
        <li class="archive-row" data-reveal>
          <div class="archive-date">
            {'date' in item
              ? <time datetime={item.date}>{displayDate(item.date)}</time>
              : <span class="placeholder-slot">{item.slot}</span>}
            <span class="archive-kind">{item.kind}</span>
          </div>
          <div class="archive-body">
            <h3>
              {'url' in item ? (
                <a href={item.url}>
                  {item.title}
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
              ) : item.title}
            </h3>
            <p>{item.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  )}
</section>

<style>
  .news-section {
    padding-top: clamp(1rem, 2.5vw, 2rem);
  }

  .lead-story {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(16.5rem, 0.85fr);
    align-items: stretch;
    gap: clamp(1.5rem, 3.2vw, 3rem);
    padding: clamp(1.75rem, 3.8vw, 3.1rem);
    border-radius: 1.05rem;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--crimson);
    background:
      radial-gradient(520px circle at var(--mx, 20%) var(--my, 20%), rgb(var(--brand-brick-rgb) / 0.08), transparent 60%),
      linear-gradient(155deg, #fcfbf9 0%, var(--paper) 100%);
    box-shadow: 0 22px 46px -34px rgb(var(--brand-graphite-rgb) / 0.22);
    transition: border-color 240ms ease, box-shadow 240ms ease, transform 240ms ease;
  }

  .lead-story:hover {
    border-color: rgb(var(--brand-brick-rgb) / 0.42);
    border-left-color: var(--crimson);
    box-shadow: 0 26px 54px -32px rgb(var(--brand-graphite-rgb) / 0.28);
  }

  .lead-main {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lead-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem 0.9rem;
    margin-bottom: 1.15rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.34rem 0.7rem;
    border-radius: 999px;
    background: rgb(var(--brand-crimson-rgb) / 0.1);
    color: var(--crimson);
    font: 600 0.69rem / 1.2 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 0 3px rgb(var(--brand-crimson-rgb) / 0.2);
  }

  .status-pill.is-live .status-dot {
    animation: news-pulse 2.2s ease-in-out infinite;
  }

  @keyframes news-pulse {
    0%, 100% { box-shadow: 0 0 0 2px rgb(var(--brand-crimson-rgb) / 0.25); }
    50% { box-shadow: 0 0 0 6px rgb(var(--brand-crimson-rgb) / 0); }
  }

  .datestamp,
  .kind-pill {
    font: 600 0.72rem / 1.3 var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .datestamp {
    color: var(--ink);
  }

  .kind-pill {
    padding: 0.24rem 0.58rem;
    border-radius: 0.3rem;
    border: 1px solid var(--rule);
    background: rgb(252 251 249 / 0.85);
    color: var(--muted);
  }

  .lead-headline {
    margin: 0 0 0.9rem;
    font: 400 clamp(1.65rem, 2.85vw, 2.55rem) / 1.13 var(--serif);
    letter-spacing: -0.025em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .lead-headline a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: color 200ms ease, background-size 260ms ease;
  }

  .lead-headline a:hover {
    color: var(--crimson);
    background-size: 100% 1px;
  }

  .arrow {
    display: inline-block;
    margin-left: 0.25rem;
    font-family: system-ui, sans-serif;
    transition: transform 200ms ease;
  }

  a:hover .arrow {
    transform: translate(2px, -2px);
  }

  .lead-summary {
    max-width: 58ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .lead-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    margin-top: 1.35rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--crimson);
    color: var(--crimson);
    font: 600 0.86rem / 1.3 var(--sans);
    text-decoration: none;
    transition: gap 180ms ease, color 180ms ease;
  }

  .lead-cta:hover {
    gap: 0.65rem;
    color: var(--burgundy);
    border-bottom-color: var(--burgundy);
  }

  .news-archive {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .archive-row {
    display: grid;
    grid-template-columns: minmax(11rem, 0.34fr) minmax(0, 1fr);
    gap: 1rem 2.25rem;
    padding: 1.45rem clamp(0.75rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--rule);
    transition: background-color 200ms ease, padding-inline 200ms ease;
  }

  .archive-row:hover {
    background: rgb(252 251 249 / 0.78);
  }

  .archive-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding-top: 0.22rem;
  }

  .archive-date time,
  .placeholder-slot {
    font: 600 0.74rem / 1.35 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .placeholder-slot {
    color: var(--muted);
  }

  .archive-kind {
    font: 600 0.67rem / 1.3 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .archive-body h3 {
    margin: 0 0 0.4rem;
    font: 500 clamp(1.22rem, 1.8vw, 1.5rem) / 1.24 var(--serif);
    letter-spacing: -0.018em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .archive-body h3 a {
    text-decoration: none;
    transition: color 180ms ease;
  }

  .archive-body h3 a:hover {
    color: var(--crimson);
  }

  .archive-body p {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.62;
  }

  .news-archive.is-placeholder .archive-row {
    border-bottom-style: dashed;
  }

  .news-archive.is-placeholder .archive-body h3 {
    color: var(--muted);
  }

  @media (max-width: 56rem) {
    .lead-story {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .archive-row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      padding-inline: 0.25rem;
    }

    .archive-date {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-pill.is-live .status-dot {
      animation: none;
    }
    .lead-story,
    .lead-headline a,
    .arrow,
    .archive-row {
      transition: none;
    }
  }
</style>

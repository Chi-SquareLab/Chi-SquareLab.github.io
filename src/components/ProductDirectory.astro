---
import { getProductGroups } from '../data/product-groups';

const groups = await getProductGroups();
---

<div class="tabula-directory not-content">
  {groups.map(({ id, label, products }) => (
    <section class="tabula-directory__group" aria-labelledby={`tabula-directory-${id}`}>
      <h3 id={`tabula-directory-${id}`}>{label}</h3>
      {products.length ? (
        <ul role="list">
          {products.map((product) => {
            const model = product.data.model;
            return (
              <li>
                <a href={product.href}>{product.data.title}</a>
                {model && (
                  <p class="tabula-directory__meta">
                    <span>{model.domain}</span>
                    <span aria-hidden="true">·</span>
                    <span>{model.baseModel}</span>
                    <span aria-hidden="true">·</span>
                    <span>{model.tasks.join(', ')}</span>
                  </p>
                )}
                {product.data.description && <p>{product.data.description}</p>}
              </li>
            );
          })}
        </ul>
      ) : <p>No products listed yet.</p>}
    </section>
  ))}
</div>

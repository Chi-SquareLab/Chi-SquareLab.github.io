---
import { legacyCollectionIds, overviewPath } from '../../navigation/legacy-bookmarks';

export function getStaticPaths() {
  return legacyCollectionIds.map(id => ({ params: { id } }));
}

const collectionsTarget = `${overviewPath}#collections`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Collections | Tabula</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${collectionsTarget}`} />
    <link rel="canonical" href={new URL(overviewPath, Astro.site)} />
  </head>
  <body><p>Browse products in <a href={collectionsTarget}>Collections</a>.</p></body>
</html>

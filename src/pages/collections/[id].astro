---
// Published collection URLs are bookmarks. The directory now lives on the homepage.
export function getStaticPaths() {
  return ['domain', 'statistics', 'science'].map(id => ({ params: { id } }));
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Collections | Tabula</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0;url=/#collections" />
    <link rel="canonical" href={new URL('/', Astro.site)} />
  </head>
  <body><p>Browse products in <a href="/#collections">Collections</a>.</p></body>
</html>
